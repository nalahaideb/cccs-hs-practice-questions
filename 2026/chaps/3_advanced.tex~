\item \textlg{\textbf{Given an array of integers, can you rotate them k steps to the right?}}

%QUESTION SPECIFICS/IMAGES HERE

%EXAMPLES HERE
\begin{console}
Example: array = [1,2,3,4,5,6,7], k = 3
rotate 1 steps to the right: [7,1,2,3,4,5,6] 
rotate 2 steps to the right: [6,7,1,2,3,4,5] 
rotate 3 steps to the right: [5,6,7,1,2,3,4]
Finished array: [5,6,7,1,2,3,4]

Example: array = [-1,-100,3,99], k = 2
rotate 1 steps to the right: [99,-1,-100,3]
rotate 2 steps to the right: [3,99,-1,-100]
Finished array: [3,99,-1,-100]

\end{console}\newpage

